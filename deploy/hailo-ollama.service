[Unit]
Description=Outpost local Hailo inference provider
After=network.target
ConditionPathExists=/dev/hailo0

[Service]
Type=simple
User=outpost
Group=outpost
WorkingDirectory=/var/lib/outpost
Environment=OLLAMA_HOST=127.0.0.1:8000
ExecStart=/usr/bin/hailo-ollama
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/usr/share/hailo-ollama/models /var/lib/outpost
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
DeviceAllow=/dev/hailo0 rw

[Install]
WantedBy=multi-user.target
