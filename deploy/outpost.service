[Unit]
Description=Outpost Meshtastic community server
After=network.target

[Service]
Type=notify
User=outpost
Group=outpost
SupplementaryGroups=dialout outpost-sdr
WorkingDirectory=/var/lib/outpost
Environment=OUTPOST_CONFIG=/etc/outpost/config.yaml
ExecStartPre=/opt/outpost/current/bin/python -c "from outpost.config import load_config; load_config()"
ExecStart=/opt/outpost/current/bin/python -m outpost
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/outpost /var/log/outpost
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service
DeviceAllow=/dev/ttyUSB0 rw
DeviceAllow=/dev/ttyACM0 rw
DeviceAllow=/dev/ttyACM1 rw
DeviceAllow=/dev/hailo0 rw
DeviceAllow=char-usb_device rw
Restart=always
RestartSec=10
WatchdogSec=120

[Install]
WantedBy=multi-user.target
